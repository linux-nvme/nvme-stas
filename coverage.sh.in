#!/usr/bin/env bash

PRIMARY_USR=$( [ -n "${SUDO_USER}" ] && echo "${SUDO_USER}" || id -nu )
PRIMARY_GRP=$( id -ng "${PRIMARY_USR}" )
PYTHON_PATH=.:./subprojects/nvme-cli/libnvme
AVAHI_PUBLISHER=mdns_publisher.service
AVAHI_ADDR_PUBLISHER=mdns_addr_publisher.service
AVAHI_BLACKHOLE_PUBLISHER=mdns_blackhole_publisher.service
AVAHI_NOHOST_PUBLISHER=mdns_nohost_publisher.service
AVAHI_REFUSED_PUBLISHER=mdns_refused_publisher.service
SCRATCH_FILE=$(mktemp /tmp/stas-coverage-out.XXXXXX)

# The daemons are started through this, which cuts the shortest EPCSD poll
# interval (1 minute) to 10 seconds. Nothing else about them changes.
LAUNCHER=$( realpath ../utils/coverage-launcher.py )

file=/tmp/stafd.conf.XXXXXX
stafd_conf_fname=$(mktemp $file)

file=/tmp/stacd.conf.XXXXXX
stacd_conf_fname=$(mktemp $file)

# The connectivity configuration: which controllers to connect to and with
# what parameters. One file serves both daemons.
file=/tmp/nvme-stas.conf.XXXXXX
stas_conf_fname=$(mktemp $file)

# Everything the daemons read from @ETC@/nvme is created here, and the units
# get it bind-mounted over the real directory. Without it the run depends on
# undeclared machine state: a stale exclusions.conf once changed what the run
# connected, for an unknown number of runs, with nothing in the script saying
# so. Results were therefore not comparable between machines, and a runner
# with no @ETC@/nvme at all was a third answer again.
ETC_NVME_DIR=$(mktemp -d /tmp/stas-etc-nvme.XXXXXX)

CYAN="[1;36m"
RED="[1;31m"
YELLOW="[1;33m"
NORMAL="[0m"

log() {
	msg="$1"
	printf "%b%s%s%b[0m\n" "\0033" ${CYAN} "${msg}" "\0033"
	sudo logger -t COVERAGE -i "@@@@@ " -p warning -- "${msg}"
}

# Start the next phase: number it, announce it on the console and in the
# journal, and give it a collapsible group of its own in a GitHub Actions log.
PHASE=0
phase() {
	PHASE=$((PHASE + 1))
	if [ -n "${GITHUB_ACTIONS}" ]; then
		[ "${PHASE}" -gt 1 ] && echo "::endgroup::"
		echo "::group::Phase ${PHASE}: $1"
	fi
	log "======== Phase ${PHASE}: $1 ========"
}

# Wait $1 seconds and say why ($2). On a terminal the remaining time counts
# down in place; anywhere else (a GitHub Actions log keeps every "\r" update
# as a line of its own) it is announced once.
countdown() {
	secs=$1
	log "$2 (${secs} s)"
	if [ -t 1 ]; then
		while [ "${secs}" -gt 0 ]; do
			printf "\r    %3d s remaining " "${secs}"
			sleep 1
			secs=$((secs - 1))
		done
		printf "\r%*s\r" 24 ""
	else
		sleep "${secs}"
	fi
}

log_file_contents() {
	rc=$1
	file=$2

	if [ $rc -eq 0 ]; then
		color=${NORMAL}
		level="info"
	else
		color=${YELLOW}
		level="error"
	fi

	while IFS= read -r line; do
		printf "%b%s%s%b[0m\n" "\0033" ${color} "   ${line}" "\0033"
	done < ${file}

        sudo file=${file} level=${level} bash <<'EOF'
while IFS= read -r line; do
	logger -t COVERAGE -i "@@@@@ " -p ${level} -- "   ${line}"
done < ${file}
EOF
}

systemctl-exists() {
	unit="$1"
	[ $(systemctl list-unit-files "${unit}" | wc -l) -gt 3 ]
}

# Write the @ETC@/nvme the daemons will see. Nothing here is copied from the
# machine: the point is that a phase behaves the same way wherever the run
# happens.
etc_nvme_populate() {
	log "Populate ${ETC_NVME_DIR}, which the daemons see as @ETC@/nvme"

	# The system identity. A connectivity configuration naming its own host
	# NQN is a persona and overrides both of these; every phase that names
	# none gets exactly this host.
	echo 'nqn.2014-08.org.nvmexpress:uuid:a1b2c3d4-0000-4000-8000-000000000001' > "${ETC_NVME_DIR}/hostnqn"
	echo 'a1b2c3d4-0000-4000-8000-000000000001' > "${ETC_NVME_DIR}/hostid"

	# libnvme's host-wide exclusion list, which stas re-reads on every
	# connection attempt. "starfleet" is one of the four subsystems nvmet
	# serves and is named nowhere else in this script, so excluding it here
	# is what exercises the list against a live target: stacd must connect
	# the other three and leave this one alone.
	cat > "${ETC_NVME_DIR}/exclusions.conf" <<'EOF'
[exclusions]
exclusion = nqn=nqn.1988-11.com.dell:starfleet
EOF

	# A named drop-in list. stas enumerates those separately from the main
	# file, so one has to exist for that path to run at all. It matches
	# nothing the target serves.
	mkdir -p "${ETC_NVME_DIR}/exclusions.conf.d"
	cat > "${ETC_NVME_DIR}/exclusions.conf.d/coverage.conf" <<'EOF'
[exclusions]
exclusion = transport=tcp;traddr=3.3.3.3
EOF

	# Deliberately no stafd.conf, stacd.conf or nvme-stas.conf. Every daemon
	# start below passes -f and -c, except the last stafd start, which takes
	# neither on purpose: it must find nothing here and fall back to the
	# built-in defaults.

	chmod -R a+rX "${ETC_NVME_DIR}"

	log_file_contents 0 "${ETC_NVME_DIR}/exclusions.conf"
	log_file_contents 0 "${ETC_NVME_DIR}/exclusions.conf.d/coverage.conf"
}

# BindPaths= gives a unit its own mount namespace with our directory over
# @ETC@/nvme - visible to the daemons and to libnvme's C code, invisible to
# everything else on the machine. It covers processes started inside units
# only: the "nvme" invocations below run outside, and act on the live system
# with the machine's own identity.
#
# Rather than compare systemd versions, try the property once on a throw-away
# unit that reads a file only our directory has. That catches a systemd too
# old to know BindPaths= as well as a machine where mount namespacing is
# unavailable, which would otherwise fail every daemon start with
# 226/NAMESPACE and leave the run with nothing to measure.
etc_nvme_bind_supported() {
	unit=stas-bind-probe-cov.service
	sudo systemctl reset-failed "${unit}" >/dev/null 2>&1
	sudo systemd-run --unit="${unit}" --wait --property=Type=oneshot \
		--property=BindPaths="${ETC_NVME_DIR}:@ETC@/nvme" \
		/bin/cat "@ETC@/nvme/exclusions.conf.d/coverage.conf" >/dev/null 2>&1
	rc=$?
	sudo systemctl reset-failed "${unit}" >/dev/null 2>&1
	return ${rc}
}

sd_stop() {
	app="$1"
	unit="${app}"-cov.service
	if systemctl-exists "${unit}" >/dev/null 2>&1; then
		log "Stop ${app}"
		sudo systemctl stop "${unit}" >${SCRATCH_FILE} 2>&1
		if [ -s ${SCRATCH_FILE} ]; then
			log_file_contents $? ${SCRATCH_FILE}
		else
			printf "   sudo systemctl stop %s\n" "${unit}"
		fi
		sudo systemctl reset-failed "${unit}" >/dev/null 2>&1
		printf "\n"
		sleep 1
	fi
}

sd_start() {
	app="$1"
	dbus="$2"
	conf="$3"
	conn_conf="$4"
	unit="${app}"-cov.service

	cmd="${app} --syslog"
	if [ -n "${conf}" ]; then
		cmd="${cmd} -f ${conf}"
	fi
	if [ -n "${conn_conf}" ]; then
		cmd="${cmd} -c ${conn_conf}"
	fi

	RUNTIME_DIRECTORY=/tmp/${app}
	rm -rf ${RUNTIME_DIRECTORY}
	mkdir ${RUNTIME_DIRECTORY}

	# Clear previous failure status (if any)
	sudo systemctl reset-failed "${unit}" >/dev/null 2>&1

	log "Start ${app}"
	# ETC_NVME_PROP is deliberately unquoted: it is one word, or nothing at
	# all on a systemd without BindPaths=.
	sudo systemd-run --unit="${unit}" --working-directory=. ${ETC_NVME_PROP} --property=Type=dbus --property=BusName="${dbus}" --property="SyslogIdentifier=${app}" --setenv=PYTHONPATH=${PYTHON_PATH} --setenv=RUNTIME_DIRECTORY=${RUNTIME_DIRECTORY} coverage run --rcfile=.coveragerc ${LAUNCHER} ${cmd}  >${SCRATCH_FILE} 2>&1
	log_file_contents $? ${SCRATCH_FILE}
	printf "\n"
	sleep 1
}

# A daemon that should be running and is not has died, which is a failure in
# itself. Stop here and show why while the evidence is fresh: in CI the runner
# has been seen to freeze minutes after such a death, taking every log with it,
# whereas a run that ends now still gets its journal collected.
expect_running() {
	app="$1"
	unit="${app}"-cov.service

	if systemctl is-active --quiet "${unit}"; then
		return
	fi

	msg="${app} died: ${unit} is not running"
	printf "%b%s%s%b[0m\n\n" "\0033" ${RED} "${msg}" "\0033"
	sudo logger -t COVERAGE -i "@@@@@ " -p err -- "${msg}"
	systemctl status --no-pager --lines=0 "${unit}" 2>&1
	printf "\n%s\n" "Last lines from ${app}:"
	sudo journalctl --no-pager -o short-iso -n 40 -u "${unit}"
	printf "\n%s\n" "Last kernel messages:"
	sudo journalctl --no-pager -o short-iso -n 40 -k
	exit 1
}

sd_restart() {
	app="$1"
	unit="${app}"-cov.service

	expect_running "${app}"
	log "Restart ${app}"
	sudo systemctl restart "${unit}" && printf "systemctl restart %s\n" "${unit}" >${SCRATCH_FILE} 2>&1
	log_file_contents $? ${SCRATCH_FILE}
	sleep 1
	printf "\n"
}

reload_cfg() {
	app="$1"
	unit="${app}"-cov.service
	# Also keeps a dead daemon's MainPID of 0 away from kill, which would
	# signal the whole process group instead.
	expect_running "${app}"
	pid=$( systemctl show --property MainPID --value "${unit}" )
	log "Reload config ${app} - SIGHUP ${pid}"
	#sudo systemctl reload "${unit}" && printf "systemctl reload %s\n" "${unit}" >${SCRATCH_FILE} 2>&1
	sudo kill -HUP "${pid}" >${SCRATCH_FILE} 2>&1
	log_file_contents $? ${SCRATCH_FILE}
	printf "\n"
	sleep 1
}

run_unit_test() {
	local input="$*"
	local -a cov_cmd
	if [ "$1" == "sudo" ]; then
		shift
		# sudo resets the environment, so a PYTHONPATH set in front of it
		# never reaches python. It has to be set on the far side, and
		# "env" does that without depending on the sudoers policy.
		# The unit tests need it: they live in ../test, so sys.path[0] is
		# that directory and staslib can only come from PYTHONPATH.
		cov_cmd=(sudo env "PYTHONPATH=${PYTHON_PATH}" coverage)
	else
		cov_cmd=(coverage)
	fi
	log "Run unit test: ${input}"
	PYTHONPATH=${PYTHON_PATH} "${cov_cmd[@]}" run --rcfile=.coveragerc "$@" </dev/null >${SCRATCH_FILE} 2>&1
	local rc=$?
	if [ ${rc} -ne 0 ]; then
		log "WARNING: Unit test FAILED (rc=${rc}): ${input}"
		log_file_contents ${rc} ${SCRATCH_FILE}
	fi
}

run_cmd_coverage() {
	input=$@
	if [ "$1" == "sudo" ]; then
		shift
		COVERAGE="sudo env PYTHONPATH=${PYTHON_PATH} coverage"
	else
		COVERAGE="coverage"
	fi
	cmd="$@"
	log "Invoke: ${input}"
	# PYTHONPATH here, not just in the sudo branch's "env": without it this
	# falls back to whatever staslib/libnvme3 happen to be importable from
	# the ambient environment - a system install, if one exists - rather
	# than the one just built in this .build tree. sudo strips a plain
	# prefix, which is why that branch also carries its own via "env"; here
	# it is redundant with that "env" but harmless.
	PYTHONPATH=${PYTHON_PATH} ${COVERAGE} run --rcfile=.coveragerc ${cmd} </dev/null >${SCRATCH_FILE} 2>&1
	log_file_contents $? ${SCRATCH_FILE}
	printf "\n"
}

run_cmd() {
	cmd="$@"
	# No input, ever. The script is started from a terminal, so stdin is a
	# tty; a command that asks for confirmation when isatty(STDIN_FILENO)
	# - "nvme disconnect-all --force" does - would block forever.
	${cmd} </dev/null >${SCRATCH_FILE} 2>&1
	if [ -s ${SCRATCH_FILE} ]; then
		log_file_contents $? ${SCRATCH_FILE}
	else
		printf "   %s\n" "${cmd}"
	fi
}

avahi_publishers_stop() {
	for unit in ${AVAHI_PUBLISHER} ${AVAHI_ADDR_PUBLISHER} ${AVAHI_BLACKHOLE_PUBLISHER} ${AVAHI_NOHOST_PUBLISHER} ${AVAHI_REFUSED_PUBLISHER}; do
		sudo systemctl stop "${unit}" >/dev/null 2>&1
		sudo systemctl reset-failed "${unit}" >/dev/null 2>&1
	done
}

prerun_setup() {
	avahi_publishers_stop

	if [ ! -d coverage ]; then
		mkdir coverage
	fi
	# Leave nothing from an earlier (possibly interrupted) run to be counted
	# in this run's report
	coverage erase --rcfile=.coveragerc

	for file in staf stac; do
	if [ ! -f "/usr/share/dbus-1/system.d/org.nvmexpress.${file}.conf" -a \
	     ! -f "/etc/dbus-1/system.d/org.nvmexpress.${file}.conf" ]; then
		log "hardlink /etc/dbus-1/system.d/org.nvmexpress.${file}.conf -> @BUILD_DIR@/etc/dbus-1/system.d/org.nvmexpress.${file}.conf"
		sudo ln @BUILD_DIR@/etc/dbus-1/system.d/org.nvmexpress.${file}.conf /etc/dbus-1/system.d/org.nvmexpress.${file}.conf
		if [ $? -ne 0 ]; then
			log "hardlink failed"
			exit 1
		fi
	fi
	done
	sudo systemctl reload dbus.service
}

postrun_cleanup() {
	phase "Clean up"
	sd_stop "stafd"
	sd_stop "stacd"

	log "nvme disconnect-all --force"
	run_cmd sudo nvme disconnect-all --force
	printf "\n"

	log "Stop nvmet"
	sudo ../utils/nvmet/nvmet.py clean >${SCRATCH_FILE} 2>&1
	log_file_contents $? ${SCRATCH_FILE}
	printf "\n"

	log "Remove ${stafd_conf_fname}, ${stacd_conf_fname}, ${stas_conf_fname} and ${ETC_NVME_DIR}"
	rm "${stafd_conf_fname}"
	rm "${stacd_conf_fname}"
	rm "${stas_conf_fname}"
	rm -rf "${ETC_NVME_DIR}"
	rm -f "${SCRATCH_FILE}"
	printf "\n"

	for file in staf stac; do
		if [ -f "/etc/dbus-1/system.d/org.nvmexpress.${file}.conf" ]; then
			if [ "$(stat -c %h -- "/etc/dbus-1/system.d/org.nvmexpress.${file}.conf")" -gt 1 ]; then
				log "Remove hardlink /etc/dbus-1/system.d/org.nvmexpress.${file}.conf"
				sudo rm "/etc/dbus-1/system.d/org.nvmexpress.${file}.conf"
			fi
		fi
	done
	sudo systemctl reload dbus.service

	sudo systemctl unmask avahi-daemon.service
	sudo systemctl unmask avahi-daemon.socket
	sudo systemctl start avahi-daemon.service
	sudo systemctl start avahi-daemon.socket

	avahi_publishers_stop

	[ -n "${GITHUB_ACTIONS}" ] && echo "::endgroup::"
	log "All done!!!"
	log "FINISHED-FINISHED-FINISHED-FINISHED-FINISHED-FINISHED-FINISHED-FINISHED"
}

trap postrun_cleanup EXIT
trap 'exit 130' SIGINT

################################################################################
################################################################################
################################################################################

log "START-START-START-START-START-START-START-START-START-START-START-START"

if systemctl is-active stafd.service >/dev/null 2>&1 || systemctl is-active stacd.service >/dev/null 2>&1; then
	msg="Stopping because stafd and/or stacd is/are currently running."
	printf "%b%s%s%b[0m\n" "\0033" ${RED} "${msg}" "\0033"
	exit 1
fi

prerun_setup

#*******************************************************************************
# Declare the @ETC@/nvme the daemons run against
phase "Set up the host: its own @ETC@/nvme, nvme_tcp, nothing connected"
etc_nvme_populate
if etc_nvme_bind_supported; then
	ETC_NVME_PROP="--property=BindPaths=${ETC_NVME_DIR}:@ETC@/nvme"
else
	ETC_NVME_PROP=""
	log "WARNING: BindPaths= is unavailable here, so the daemons will read the machine's own @ETC@/nvme"
fi
printf "\n"

#*******************************************************************************
# Load nvme kernel module
log "modprobe nvme_tcp"
run_cmd sudo /usr/sbin/modprobe nvme_tcp

log "nvme disconnect-all --force"
run_cmd sudo nvme disconnect-all --force
printf "\n"

sd_stop stafd # make sure it's not running already
sd_stop stacd # make sure it's not running already

#*******************************************************************************
# Create a dummy config file for stafd
# "johnny", "queue-size" and "reconnect-delay" are deliberate: the first was
# never a keyword, the other two moved to the connectivity configuration. All
# three must draw the "contains invalid options" warning and be ignored.
phase "Write deliberately flawed starting configurations"
log "Create dummy config file ${stafd_conf_fname}"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron              = true
ip-family         = ipv6
johnny            = be-good
queue-size        = 2000000
reconnect-delay   = NaN

[Discovery controller connection management]
dc-giveup-timeout = infinity

[Hello]
hello = bye
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

#*******************************************************************************
# Create a dummy config file for stacd
# Likewise "kato" and "nr-io-queues": both moved, both must be ignored here.
# "connect-attempts-on-ncc = 1" is coerced to 2, and the "=" entry of
# "exclude" sets no field, so it would match every controller and is dropped.
log "Create dummy config file ${stacd_conf_fname}"
cat > "${stacd_conf_fname}" <<'EOF'
[Global]
tron              = true
kato              = 10
nr-io-queues      = 4

[I/O controller connection management]
honor-fabric-zoning     = blah-blah
connect-attempts-on-ncc = 1

[Controllers]
exclude=
exclude=transport=tcp;traddr=
EOF
log_file_contents 0 "${stacd_conf_fname}"
printf "\n"

#*******************************************************************************
# Create a dummy connectivity configuration. One file serves both daemons:
# stafd takes the [Discovery Controller] sections, stacd the [Subsystem] ones.
# stacd has none here on purpose - its I/O controllers come from the discovery
# log pages stafd retrieves.
log "Create dummy connectivity configuration ${stas_conf_fname}"
cat > "${stas_conf_fname}" <<'EOF'
[Host]
hostsymname = coverage-host

[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
keep-alive-tmo  = 30
queue-size      = 2000000
ctrl-loss-tmo   = 10
disable-sqflow  = true

[I/O Controller Defaults]
nr-io-queues    = 4
queue-size      = 2000000
reconnect-delay = 1
ctrl-loss-tmo   = 1
disable-sqflow  = true
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

phase "Clients with no daemon running, avahi-daemon masked"
# Mask first: on a desktop, gvfsd-dnssd D-Bus-activates avahi-daemon again
# as soon as it stops, and would have it running before the mask landed.
log "Mask & Stop Avahi daemon"
run_cmd sudo systemctl mask avahi-daemon.service
run_cmd sudo systemctl mask avahi-daemon.socket
run_cmd sudo systemctl stop avahi-daemon.service
run_cmd sudo systemctl stop avahi-daemon.socket
printf "\n"
sleep 1

run_cmd_coverage stafctl ls
run_cmd_coverage stafctl invalid-command
run_cmd_coverage stafctl
run_cmd_coverage stacctl ls
run_cmd_coverage stacctl invalid-command
run_cmd_coverage stacctl

#*******************************************************************************
phase "Start nvmet"
log "Start nvmet"
sudo ../utils/nvmet/nvmet.py clean >/dev/null 2>&1
sudo ../utils/nvmet/nvmet.py create -f ../utils/nvmet/nvmet.conf >${SCRATCH_FILE} 2>&1
log_file_contents $? ${SCRATCH_FILE}
printf "\n"

sleep 2

#*******************************************************************************
phase "Start stafd and stacd with avahi-daemon masked, then bring it back"
sd_start "stafd" "@STAFD_DBUS_NAME@" "${stafd_conf_fname}" "${stas_conf_fname}"
sd_start "stacd" "@STACD_DBUS_NAME@" "${stacd_conf_fname}" "${stas_conf_fname}"
sleep 2

run_cmd_coverage stafctl status

reload_cfg "stafd"
sleep 1

log "Restart Avahi daemon"
run_cmd sudo systemctl unmask avahi-daemon.socket
run_cmd sudo systemctl unmask avahi-daemon.service
run_cmd sudo systemctl start avahi-daemon.socket
run_cmd sudo systemctl start avahi-daemon.service
printf "\n"
sleep 2

phase "Change stafd config: add a discovery controller"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron = true

[Discovery controller connection management]
dc-giveup-timeout = 0.5

[Service Discovery]
zeroconf = enabled
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

# The secrets go on the section, not the "controller =" line: libnvme binds
# them to the (hostnqn, subsysnqn) pair and rejects the file otherwise.
cat > "${stas_conf_fname}" <<'EOF'
[Host]
hostsymname = coverage-host

[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
keep-alive-tmo = 30

[Discovery Controller]
kxchap-secret      = DHHC-1:00:very-secret/very-secret/very-secret/very-secret/:
kxchap-ctrl-secret = DHHC-1:00:not-so-secret/not-so-secret/not-so-secret/not-so:
keep-alive-tmo     = 31
controller         = transport=tcp;traddr=localhost;trsvcid=8009
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"
sleep 5

phase "Change stafd config: unreachable controllers, one of them excluded"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron              = true
ip-family         = ipv4
pleo              = disabled

[Discovery controller connection management]
dc-giveup-timeout  = 1:01

[Controllers]
exclude=transport=tcp;traddr=1.1.1.1
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

# Whitespace around the separators is deliberate - libnvme tolerates it.
cat > "${stas_conf_fname}" <<'EOF'
[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
keep-alive-tmo  = 30
queue-size      =
reconnect-delay = 1
ctrl-loss-tmo   = 1
disable-sqflow  = true

[Discovery Controller]
controller = transport = tcp ; traddr = localhost ; trsvcid = 8009

[Discovery Controller]
controller = transport=tcp;traddr=1.1.1.1

[Discovery Controller]
controller = transport=tcp;traddr=100.100.100.100

[Discovery Controller]
controller = transport=tcp;traddr=2607:f8b0:4002:c2c::71

# A discovery controller with an NQN of its own. The kernel applies its 30 s
# discovery default only to the well-known NQN, so this one depends on the
# keep-alive-tmo above.
[Discovery Controller]
nqn        = nqn.2014-08.org.example:cdc.main
controller = transport=tcp;traddr=localhost;trsvcid=8009
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"
sleep 3

phase "Change stacd config: fabric zoning off, an invalid connect-attempts-on-ncc"
cat > "${stacd_conf_fname}" <<'EOF'
[Global]
tron=true

[I/O controller connection management]
honor-fabric-zoning=no
connect-attempts-on-ncc=NaN
EOF
log_file_contents 0 "${stacd_conf_fname}"
printf "\n"

reload_cfg "stacd"
sleep 5

#*******************************************************************************
# Give stacd an I/O subsystem of its own. Everything it has connected so far
# came from a discovery log page; this is the configured path. The two
# "controller =" lines are two paths to one subsystem, and the second overrides
# the section's ctrl-loss-tmo for that path only.
#
phase "Change connectivity configuration: a configured I/O subsystem"
cat > "${stas_conf_fname}" <<'EOF'
[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
keep-alive-tmo = 30

[I/O Controller Defaults]
nr-io-queues  = 4
ctrl-loss-tmo = 1

[Discovery Controller]
controller = transport=tcp;traddr=localhost;trsvcid=8009

[Subsystem]
nqn           = nqn.1988-11.com.dell:PowerSANxxx:01:20210225100113-454f73093ceb4847a7bdfc6e34ae8e28
ctrl-loss-tmo = 1800
controller    = transport=tcp;traddr=localhost;trsvcid=8009
controller    = transport=tcp;traddr=127.0.0.1;trsvcid=8009;ctrl-loss-tmo=5

# Configured as well as discovered, so that unlinking it from the port
# further down exercises a zoning change against a subsystem we were told
# to connect, not merely one a discovery log page reported.
[Subsystem]
nqn        = nqn.1988-11.com.dell:klingons
controller = transport=tcp;traddr=localhost;trsvcid=8009
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"
reload_cfg "stacd"
sleep 5

run_cmd_coverage stafctl status

#*******************************************************************************
phase "Announce a discovery controller over mDNS"
log "Start Avahi publisher"
run_cmd sudo systemctl stop ${AVAHI_PUBLISHER}
run_cmd sudo systemctl reset-failed ${AVAHI_PUBLISHER}
run_cmd sudo systemd-run --unit=${AVAHI_PUBLISHER} --working-directory=. avahi-publish -s SFSS _nvme-disc._tcp 8009 "p=tcp"
printf "\n"
sleep 1

#*******************************************************************************
run_cmd_coverage stafd --version
run_cmd_coverage stacd --version

#*******************************************************************************
phase "stafctl and stacctl against the running daemons"
run_cmd_coverage sudo stafctl --version
run_cmd_coverage sudo stafctl blah
run_cmd_coverage sudo stafctl troff
run_cmd_coverage stafctl status
run_cmd_coverage sudo stafctl tron
run_cmd_coverage stafctl ls
run_cmd_coverage stafctl ls -d
run_cmd_coverage stafctl adlp
run_cmd_coverage stafctl adlp -d
run_cmd_coverage stafctl dlp -t tcp -a ::1 -s 8009

run_cmd_coverage sudo stacctl --version
run_cmd_coverage sudo stacctl blah
run_cmd_coverage sudo stacctl troff
run_cmd_coverage stacctl status
run_cmd_coverage sudo stacctl tron
run_cmd_coverage stacctl ls
run_cmd_coverage stacctl ls -d

#*******************************************************************************
phase "AENs: unlink and relink klingons"
log "Remove namespace: klingons"
run_cmd sudo ../utils/nvmet/nvmet.py unlink -p 1 -s nqn.1988-11.com.dell:klingons
printf "\n"
sleep 4
run_cmd_coverage stacctl ls
run_cmd_coverage stacctl ls -d

log "Restore namespace: klingons"
run_cmd sudo ../utils/nvmet/nvmet.py link -p 1 -s nqn.1988-11.com.dell:klingons
printf "\n"
sleep 4
run_cmd_coverage stacctl ls
run_cmd_coverage stacctl ls -d

#*******************************************************************************
phase "mDNS: invalid, RoCE, missing and TCP protocols in the TXT record"
log "Restart Avahi publisher with invalid protocol"
run_cmd sudo systemctl stop ${AVAHI_PUBLISHER}
printf "\n"
sleep 1
run_cmd sudo systemd-run --unit=${AVAHI_PUBLISHER} --working-directory=. avahi-publish -s SFSS _nvme-disc._tcp 8009 "p=walmart"
printf "\n"
sleep 2

#*******************************************************************************
log "Restart Avahi publisher with protocol set to RoCE"
run_cmd sudo systemctl stop ${AVAHI_PUBLISHER}
printf "\n"
sleep 1
run_cmd sudo systemd-run --unit=${AVAHI_PUBLISHER} --working-directory=. avahi-publish -s SFSS _nvme-disc._tcp 8009 "p=roce"
printf "\n"
sleep 2

#*******************************************************************************
log "Restart Avahi publisher without specifying protocol"
run_cmd sudo systemctl stop ${AVAHI_PUBLISHER}
printf "\n"
sleep 1
run_cmd sudo systemd-run --unit=${AVAHI_PUBLISHER} --working-directory=. avahi-publish -s SFSS _nvme-disc._tcp 8009
printf "\n"
sleep 2

#*******************************************************************************
log "Restart Avahi publisher with protocol set to TCP"
run_cmd sudo systemctl stop ${AVAHI_PUBLISHER}
printf "\n"
sleep 1
run_cmd sudo systemd-run --unit=${AVAHI_PUBLISHER} --working-directory=. avahi-publish -s SFSS _nvme-disc._tcp 8009 "p=tcp"
printf "\n"
sleep 2

#*******************************************************************************
# Three DCs that can never be used:
# - blackhole.local resolves to 192.0.2.1 (TEST-NET-1), which nothing
#   answers, so its connectivity check is still pending when it is withdrawn.
#   The address record is published on every interface, so stafd also sees
#   one IP on several interfaces.
# - SFSS-refused is this host at port 8010, where nothing listens: its check
#   is refused at once and retried.
# - nohost.local has no address record at all, so its resolver times out.
phase "mDNS: DCs that cannot be reached, and one with no address"
log "Publish DCs that cannot be reached, and one with no address"
run_cmd sudo systemd-run --unit=${AVAHI_ADDR_PUBLISHER} --working-directory=. avahi-publish -a -R blackhole.local 192.0.2.1
run_cmd sudo systemd-run --unit=${AVAHI_BLACKHOLE_PUBLISHER} --working-directory=. avahi-publish -s -H blackhole.local SFSS-blackhole _nvme-disc._tcp 8009 "p=tcp"
run_cmd sudo systemd-run --unit=${AVAHI_REFUSED_PUBLISHER} --working-directory=. avahi-publish -s SFSS-refused _nvme-disc._tcp 8010 "p=tcp"
run_cmd sudo systemd-run --unit=${AVAHI_NOHOST_PUBLISHER} --working-directory=. avahi-publish -s -H nohost.local SFSS-nohost _nvme-disc._tcp 8009 "p=tcp"
printf "\n"
sleep 8

run_cmd_coverage stafctl status

log "Withdraw them"
run_cmd sudo systemctl stop ${AVAHI_BLACKHOLE_PUBLISHER}
run_cmd sudo systemctl stop ${AVAHI_REFUSED_PUBLISHER}
run_cmd sudo systemctl stop ${AVAHI_NOHOST_PUBLISHER}
run_cmd sudo systemctl stop ${AVAHI_ADDR_PUBLISHER}
printf "\n"
sleep 1

#*******************************************************************************
# Take avahi-daemon away while stafd has services discovered. Mask first:
# freeing the browsers and resolvers would otherwise D-Bus-activate it again.
phase "avahi-daemon goes away while services are discovered"
log "Mask & Stop Avahi daemon while services are discovered"
run_cmd sudo systemctl mask avahi-daemon.service
run_cmd sudo systemctl mask avahi-daemon.socket
run_cmd sudo systemctl stop avahi-daemon.service
run_cmd sudo systemctl stop avahi-daemon.socket
printf "\n"
sleep 2

# A reload wakes avahi-daemon up immediately. With zeroconf on, the same
# reload would push that wake-up back by its full period.
log "Turn zeroconf off while avahi-daemon is gone"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron = true

[Discovery controller connection management]
dc-giveup-timeout = 0.5

[Service Discovery]
zeroconf = disabled
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

reload_cfg "stafd"
sleep 1

log "Restart Avahi daemon and turn zeroconf back on"
run_cmd sudo systemctl unmask avahi-daemon.socket
run_cmd sudo systemctl unmask avahi-daemon.service
run_cmd sudo systemctl start avahi-daemon.socket
run_cmd sudo systemctl start avahi-daemon.service
printf "\n"
sleep 2

cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron = true

[Discovery controller connection management]
dc-giveup-timeout = 0.5

[Service Discovery]
zeroconf = enabled
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

reload_cfg "stafd"

run_cmd sudo systemctl stop ${AVAHI_PUBLISHER}
run_cmd sudo systemctl reset-failed ${AVAHI_PUBLISHER}
run_cmd sudo systemd-run --unit=${AVAHI_PUBLISHER} --working-directory=. avahi-publish -s SFSS _nvme-disc._tcp 8009 "p=tcp"
printf "\n"
sleep 3

#*******************************************************************************
phase "Change stafd config: zeroconf off"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron              = true

[Discovery controller connection management]
dc-giveup-timeout=0.5

[Service Discovery]
zeroconf=disabled
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

reload_cfg "stafd"
sleep 5

#*******************************************************************************
phase "Change stafd config: addresses stas itself has to reject"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron=true
ip-family=ipv6
pleo=disabled

[Discovery controller connection management]
dc-giveup-timeout=0
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

# Every entry here passes libnvme's validation and reaches stas, which is the
# point: name resolution failures, an unsupported transport and a malformed
# address are stas' to handle. Entries libnvme rejects outright are exercised
# separately, below, since one of them would sink the whole file.
cat > "${stas_conf_fname}" <<'EOF'
[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
keep-alive-tmo  = 30
queue-size      = 2000000
reconnect-delay = 1
ctrl-loss-tmo   = 0
disable-sqflow  = true

[Discovery Controller]
controller = transport=tcp;traddr=localhost;trsvcid=8009

[Discovery Controller]
controller = transport=tcp;traddr=abracadabra

[Discovery Controller]
controller = transport=tcp;traddr=google.com

[Discovery Controller]
controller = transport=rdma;traddr=!@#$

[Discovery Controller]
controller = transport=fc;traddr=21:00:00:00:00:00:00:00;host-traddr=20:00:00:00:00:00:00:00

[Discovery Controller]
controller = transport=XM;traddr=2.2.2.2

[Discovery Controller]
controller = transport=tcp;traddr=555.555.555.555

# A port nobody listens on, so the target refuses the connection outright.
# nvmet listens on "::", which accepts everything that reaches it, so this
# is the only entry that exercises ECONNREFUSED. Note the address has to be
# IPv6: this phase sets "ip-family=ipv6", which would filter out 127.0.0.1
# before we ever tried to connect.
[Discovery Controller]
controller = transport=tcp;traddr=::1;trsvcid=8010
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"
sleep 2

# Force reading stacd's last know config
sd_restart "stacd"
sleep 3

#*******************************************************************************
phase "Withdraw the mDNS announcement"
log "Stop Avahi publisher"
run_cmd sudo systemctl stop ${AVAHI_PUBLISHER}
printf "\n"
sleep 2

#*******************************************************************************
# The other side of the phase above. nvmet listens on "::", so it reports its
# IPv4 addresses in IPv4-mapped form ("::ffff:127.0.0.1") in the discovery log
# pages. Those name IPv4 controllers however they are spelled, and
# "ip-family=ipv4" has to keep them: reading the mapped form as IPv6 would
# throw away every controller this target advertises. stacd is where it
# matters most - the mapped addresses arrive in the log pages it reads from
# stafd - so both daemons are set to IPv4 here.
phase "IPv4 only, against a target reporting IPv4-mapped addresses"
log "Change stafd config: IPv4 only, against a target reporting IPv4-mapped addresses"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron=true
ip-family=ipv4
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

log "Change stacd config: IPv4 only"
cat > "${stacd_conf_fname}" <<'EOF'
[Global]
tron=true
ip-family=ipv4
EOF
log_file_contents 0 "${stacd_conf_fname}"
printf "\n"

cat > "${stas_conf_fname}" <<'EOF'
[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
keep-alive-tmo = 30

[Discovery Controller]
controller = transport=tcp;traddr=localhost;trsvcid=8009
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"
reload_cfg "stacd"
sleep 5

# Put both families back. Nothing later changes stacd.conf, and the phases
# that follow reach subsystems over a link-local IPv6 address, which an
# IPv4-only stacd would drop.
log "Change stacd config: both families again"
cat > "${stacd_conf_fname}" <<'EOF'
[Global]
tron=true
EOF
log_file_contents 0 "${stacd_conf_fname}"
printf "\n"

reload_cfg "stacd"
sleep 3

#*******************************************************************************
phase "Disconnect a DC and an I/O controller behind the daemons' backs"
file=/tmp/getdev-XXX.py
getdev=$(mktemp $file)
cat > "${getdev}" <<'EOF'
import sys
import dasbus
import dasbus.connection

bus = dasbus.connection.SystemMessageBus()
iface = bus.get_proxy(sys.argv[1], sys.argv[2])
try:
    controllers = iface.list_controllers(False)
except dasbus.error.DBusError:
    controllers = []

for controller in controllers:
    device = controller['device']
    if device != 'nvme?':
        print(device)
        sys.exit(0)

print("")
sys.exit(1)
EOF

# Wait for a connected controller rather than sampling once. A controller
# takes a moment to come up after a reload, and a discovery controller that
# is parked reports "nvme?" until its poll timer brings it back, so a single
# look can miss a connection that is on its way.
get_device() {
    local bus=$1
    local path=$2
    local dev=""
    for _ in $(seq 1 15); do
        dev=$(python3 ${getdev} ${bus} ${path})
        if [[ -n "${dev}" ]]; then
            break
        fi
        sleep 1
    done
    echo ${dev}
}

# Find a Discovery Controller and issue a "nvme disconnect"
dev=$(get_device @STAFD_DBUS_NAME@ @STAFD_DBUS_PATH@)
if [[ -n "${dev}" ]]; then
	log "Remove connection (disconnect) to Discovery Controller ${dev}"
	run_cmd sudo nvme disconnect -d ${dev}
	printf "\n"
else
	msg="Failed to find a connection to a Discovery Controller"
	printf "%b%s%s%b[0m\n" "\0033" ${RED} "${msg}" "\0033"
	sudo logger -t COVERAGE -i "@@@@@ " -p warning -- "${msg}"
fi

# Find an I/O Controller and issue a "nvme disconnect"
dev=$(get_device @STACD_DBUS_NAME@ @STACD_DBUS_PATH@)
if [[ -n "${dev}" ]]; then
	log "Remove connection (disconnect) to I/O Controller ${dev}"
	run_cmd sudo nvme disconnect -d ${dev}
	printf "\n"
else
	msg="Failed to find a connection to an I/O Controller"
	printf "%b%s%s%b[0m\n" "\0033" ${RED} "${msg}" "\0033"
	sudo logger -t COVERAGE -i "@@@@@ " -p warning -- "${msg}"
fi

sleep 3

rm "${getdev}"

#*******************************************************************************
phase "Restart both daemons; make stafd's last known config unusable, then usable again"
sd_restart "stafd"
sd_restart "stacd"
sleep 4

log "Create invalid conditions for saving/loading stafd's last known config"
rm -rf "/tmp/stafd"
sd_restart "stafd"
sleep 2

log "Remove invalid conditions for saving/loading stafd's last known config"
mkdir -p "/tmp/stafd"
sd_restart "stafd"
sleep 2

phase "Change stafd config: connect under a persona"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron              = true
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

# A configuration that names its own host NQN is a persona, and the identity
# is taken whole: the host ID and symbolic name come with it, never the
# system's. Pairing a configured host NQN with the system host ID would make
# the subsystem treat the two as one host (TP4126).
cat > "${stas_conf_fname}" <<'EOF'
[Host]
hostnqn     = nqn.1988-11.com.dell:persona:1
hostid      = aaaaaaaa-0000-0000-0000-000000000001
hostsymname = persona-one

[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
keep-alive-tmo = 30

[Discovery Controller]
controller = transport=tcp;traddr=localhost;trsvcid=8009

[Discovery Controller]
controller = transport=tcp;traddr=1.1.1.1
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"
sleep 2

#*******************************************************************************
# Let a discovery controller park. nvmet reports EPCSD=0, so under "auto" the
# DC does not support a persistent connection: stafd disconnects it, keeps its
# log pages, and comes back on the poll timer. One minute is the shortest
# interval the option accepts; the launcher makes it 10 seconds.
phase "Change stafd config: let a DC park, then come back"
cat > "${stafd_conf_fname}" <<'EOF'
[Global]
tron                        = true

[Discovery controller connection management]
epcsd-poll-interval-minutes = 1
EOF
log_file_contents 0 "${stafd_conf_fname}"
printf "\n"

cat > "${stas_conf_fname}" <<'EOF'
[Discovery Controller Defaults]
persistent     = auto
keep-alive-tmo = 30

[Discovery Controller]
controller = transport=tcp;traddr=localhost;trsvcid=8009
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"

# Persistence is decided as soon as the DC's log page is in, which is within
# about a second of the reload.
countdown 5 "Waiting for stafd to decide the DC's persistence"
log "stafd should now have parked the DC (EPCSD=0)"
run_cmd_coverage stafctl ls
run_cmd_coverage stafctl status

# The poll interval (10 s, see LAUNCHER), plus a margin
countdown 20 "Waiting out the 10 s poll interval so the DC comes back"
run_cmd_coverage stafctl ls
run_cmd_coverage stafctl status

#*******************************************************************************
# The same DC, kept across the reload, switched to "no". Its next poll is a new
# connection, so it must use the new parameters: keep-alive-tmo is overridden
# to 0 (logged once), since "no" means the connection is not to be kept.
phase "Change connectivity configuration: the parked DC turns persistent=no"
cat > "${stas_conf_fname}" <<'EOF'
[Discovery Controller Defaults]
persistent     = no
keep-alive-tmo = 30

[Discovery Controller]
controller = transport=tcp;traddr=localhost;trsvcid=8009
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"

countdown 20 "Waiting out the 10 s poll interval so the DC reconnects with keep-alive-tmo=0"
run_cmd_coverage stafctl ls
run_cmd_coverage stafctl status

#*******************************************************************************
# A connectivity configuration that libnvme rejects outright. stafd must keep
# the previous one running rather than tear down working connections.
phase "A connectivity configuration that must be rejected, then built-in defaults"
cat > "${stas_conf_fname}" <<'EOF'
[Discovery Controller Defaults]
# nvmet never sets EFLAGS, so it always reports EPCSD=0. Hold the
# connections open anyway - that is what "force" is for.
persistent     = force
queue-size = NaN

[Discovery Controller]
controller =

[Discovery Controller]
controller = trsvcid

[Discovery Controller]
controller = transport=tcp;traddr=localhost;kato=31
EOF
log_file_contents 0 "${stas_conf_fname}"
printf "\n"

reload_cfg "stafd"
sleep 2

sd_stop "stafd"
sleep 5
sd_start "stafd" "@STAFD_DBUS_NAME@"
sleep 3

# A daemon writes its coverage data when it exits, so both must be gone before
# the data is collected. Stopped any later, their data would be lost on a
# fresh runner and counted in the next run's report on a reused build dir.
log "Stop the daemons"
sd_stop "stafd"
sd_stop "stacd"

#*******************************************************************************
# Change ownership of files that were created as root
sudo chown -R "${PRIMARY_USR}":"${PRIMARY_GRP}" coverage  >/dev/null 2>&1
find staslib/__pycache__ -maxdepth 0 -type d 2>/dev/null | xargs -r sudo chown -R "${PRIMARY_USR}":"${PRIMARY_GRP}"
find subprojects/nvme-cli/libnvme/libnvme3/__pycache__ -maxdepth 0 -type d 2>/dev/null | xargs -r sudo chown -R "${PRIMARY_USR}":"${PRIMARY_GRP}"

#*******************************************************************************
# Run unit tests
#
# Every test/test-*.py, found rather than listed: the list this replaces had
# fallen four files behind (test-conn-conf, test-exclusions, test-protection
# and test-singleton were never added to it), and the code they cover read as
# untested in the report for no better reason than that.
phase "Unit tests"
TEST_DIR=$( realpath ../test )
for test_file in "${TEST_DIR}"/test-*.py; do
	run_unit_test "${test_file}"
done

# NvmeOptions probes /dev/nvme-fabrics, which reads differently depending on
# who is asking, so it runs a second time as root.
run_unit_test sudo ${TEST_DIR}/test-nvme_options.py

#*******************************************************************************
phase "Coverage report"

log "Collect all coverage data"
coverage combine --rcfile=.coveragerc
printf "\n"

log "Generating coverage report"
coverage report -i --rcfile=.coveragerc
printf "\n"

log "Generating coverage report (HTML)"
coverage html -i --rcfile=.coveragerc
printf "\n"

