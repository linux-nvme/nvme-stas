[Unit]
Description=nvme-stas @ETC@/nvme/%i auto-generation
Documentation=man:stas-config@.service(8)
ConditionFileNotEmpty=|!@ETC@/nvme/%i

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'case %i in hostnqn) nvme gen-hostnqn ;; hostid) uuidgen ;; *) echo "unknown host identity: %i" >&2; exit 1 ;; esac > @ETC@/nvme/%i'

[Install]
WantedBy=stas-config.target
